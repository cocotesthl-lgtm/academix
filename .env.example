# =====================================================================
# App
# =====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=curplat.com

# =====================================================================
# Supabase (project settings → API)
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # server-only; never expose

# =====================================================================
# Upstash Redis (slug → tenant_id cache + rate limit)
# Optional in dev: falls back to in-memory map if empty.
# =====================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =====================================================================
# Affiliate cookie signing
# Generate with: openssl rand -hex 32
# =====================================================================
AFFILIATE_COOKIE_SECRET=

# =====================================================================
# MercadoPago (per-owner OAuth — these are PLATFORM app credentials)
# =====================================================================
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://app.curplat.com/api/oauth/mercadopago/callback
# Platform-owned MP account (for receiving debt payments from owners)
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
PLATFORM_MP_WEBHOOK_SECRET=

# =====================================================================
# Cron secret (for /api/cron/* endpoints — used by Vercel Cron header
# Authorization: Bearer <CRON_SECRET>)
# =====================================================================
CRON_SECRET=

# =====================================================================
# Shopify (per-owner OAuth)
# =====================================================================
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://app.curplat.com/api/oauth/shopify/callback
SHOPIFY_SCOPES=read_orders,read_products

# =====================================================================
# Google Drive (per-owner OAuth)
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.curplat.com/api/oauth/google-drive/callback

# =====================================================================
# Resend (emails transactional)
# Free tier: 3,000 emails/mes. Sign up: https://resend.com
# El dominio del FROM_EMAIL tiene que estar verificado en Resend (DNS records).
# Si RESEND_API_KEY queda vacío, los emails se loguean pero no se envían
# (modo defensivo — no rompe webhooks).
# =====================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bzseguridad.store
RESEND_FROM_NAME=Curplat

# =====================================================================
# Vercel API (custom domains)
# Para que los owners conecten su propio dominio:
# 1. Crear token: vercel.com/account/tokens → "Create Token"
# 2. Project ID: en tu proyecto Vercel → Settings → "Project ID"
# 3. Team ID (solo si proyecto bajo team): Settings → "Team ID"
# =====================================================================
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

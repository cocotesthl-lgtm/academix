# =====================================================================
# App
# =====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=curplat.com

# =====================================================================
# Supabase (project settings → API)
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # server-only; never expose

# =====================================================================
# Upstash Redis (slug → tenant_id cache + rate limit)
# Optional in dev: falls back to in-memory map if empty.
# =====================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =====================================================================
# Affiliate cookie signing
# Generate with: openssl rand -hex 32
# =====================================================================
AFFILIATE_COOKIE_SECRET=

# =====================================================================
# MercadoPago (per-owner OAuth — these are PLATFORM app credentials)
# =====================================================================
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://app.curplat.com/api/oauth/mercadopago/callback
# Platform-owned MP account (for receiving debt payments from owners)
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=

# =====================================================================
# Shopify (per-owner OAuth)
# =====================================================================
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://app.curplat.com/api/oauth/shopify/callback
SHOPIFY_SCOPES=read_orders,read_products

# =====================================================================
# Google Drive (per-owner OAuth)
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.curplat.com/api/oauth/google-drive/callback
